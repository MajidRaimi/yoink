{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "gen:data": "bun run scripts/gen-data.ts",
    "resolve:release": "bun run scripts/resolve-release.ts",
    "build:search": "bun run scripts/build-search.ts",
    "prebuild": "bun run resolve:release && bun run build:search",
    "build": "next build && bun run scripts/finalize-og.ts",
    "typecheck": "tsc --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "test": "bun test src scripts",
    "check:links": "bun run scripts/check-links.ts",
    "check:slop": "bun run scripts/check-slop.ts",
    "test:e2e": "playwright test",
    "lhci": "bunx lhci autorun --config=./lighthouserc.json"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@yoink/tokens": "workspace:*",
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "mdast-util-to-string": "^4.0.0",
    "minisearch": "^7.2.0",
    "motion": "^12.0.0",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "simple-icons": "^16.34.0",
    "tailwind-merge": "^3.3.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.0",
    "serve": "^14.2.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.0"
  }
}
